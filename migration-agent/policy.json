{
  "agentName": "Self-Healing Legacy Dependency Migration Agent",
  "version": "1.0.0",
  "executionMode": "ANALYSIS_ONLY",

  "allowAutomaticChanges": false,
  "allowBranchCreation": false,
  "allowPullRequestCreation": false,

  "minimumResearchSources": 2,
  "minimumConfidenceScore": 0.8,

  "supportedPlatforms": {
    "java": [
      "8"
    ],
    "springBoot": [
      "1.5"
    ]
  },

  "reports": {
    "generateBuildAnalysis": true,
    "generatePomScan": true,
    "generateDependencyScan": true,
    "generateCompatibilityReport": true,
    "generateMigrationPlan": true,
    "generateFinalReport": true
  }
}